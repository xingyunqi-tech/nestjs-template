NODE_ENV=development
APP_PORT=3000
APP_NAME="NestJS API"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:3000

# Logger - Levels: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=debug
LOG_PRETTY_PRINT=true

DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=root
DATABASE_PASSWORD=secret
DATABASE_NAME=api
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=true
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
DATABASE_URL=

# Support "local", "s3", "s3-presigned"
FILE_DRIVER=local
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_DEFAULT_S3_BUCKET=
# For Aliyun OSS: https://oss-cn-hangzhou.aliyuncs.com
AWS_S3_ENDPOINT=
# Only used with AWS_S3_ENDPOINT: true for MinIO, false for Aliyun OSS
AWS_S3_FORCE_PATH_STYLE=true
# 各上传用途的大小上限（字节）
FILE_IMAGE_MAX_SIZE=5242880
FILE_PRIVATE_IMAGE_MAX_SIZE=10485760
FILE_CONTENT_IMAGE_MAX_SIZE=5242880
FILE_AUDIO_MAX_SIZE=20971520
FILE_IMPORT_MAX_SIZE=52428800
FILE_EXPORT_MAX_SIZE=20971520

MAIL_HOST=maildev
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME=Api
MAIL_CLIENT_PORT=1080

AUTH_JWT_SECRET=secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=secret_for_refresh
AUTH_REFRESH_TOKEN_EXPIRES_IN=3650d
AUTH_FORGOT_SECRET=secret_for_forgot
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=secret_for_confirm_email
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d

# Redis Configuration (for caching, queues, and sessions)
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting (Throttler)
# Set to false in CI/test environments
THROTTLE_ENABLED=false
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# 应用前的反向代理层数（Nginx/SLB 等），限流按 X-Forwarded-For 识别客户端 IP；直连时为 0
TRUST_PROXY=0

# Prometheus Metrics
METRICS_ENABLED=true
METRICS_PATH=metrics
# Bearer token for /metrics; without it /metrics is denied in production
METRICS_TOKEN=

# Aliyun SMS Service (for phone verification codes)
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_CODE_EXPIRES=300
SMS_CODE_LENGTH=6
SMS_ENDPOINT=dysmsapi.aliyuncs.com
SMS_MOCK_MODE=true
SMS_MAX_ATTEMPTS=5
SMS_RESEND_INTERVAL=60

# WeChat Integration (Mini Program and Official Account)
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 订阅消息跳转的小程序版本：developer / trial / formal
WECHAT_MINI_PROGRAM_STATE=formal
# 订阅消息模板（支付成功），模板 ID 需与小程序端 VITE_WX_TMPL_ORDER_PAID 一致
# 字段映射格式：业务字段:模板字段key，可用业务字段 orderNo / amount / paidAt
WECHAT_SUBSCRIBE_ORDER_PAID_TEMPLATE_ID=
WECHAT_SUBSCRIBE_ORDER_PAID_FIELDS=orderNo:character_string1,amount:amount2,paidAt:time3

# WeChat Pay Configuration
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_NOTIFY_URL=
# 微信支付公钥模式（新商户默认）填写以下两项；留空则自动下载平台证书
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=

# Alipay Payment Integration
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_CHARSET=utf-8
ALIPAY_NOTIFY_URL=
# 网页支付完成后的跳转地址，指向 H5 支付结果页（会追加 orderId 参数），如 https://h5.example.com/pages-sub/order/payment-result/index
ALIPAY_RETURN_URL=
ALIPAY_SANDBOX=false

# LLM（OpenAI 兼容协议），默认 DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 单次请求总时长上限（毫秒），1000–240000
LLM_TIMEOUT_MS=120000

# AI 成本估算的模型单价（元/百万 token），按当前模型的官方价格填写
AI_PRICE_INPUT_CACHE_HIT=0.2
AI_PRICE_INPUT_CACHE_MISS=2
AI_PRICE_OUTPUT=3
